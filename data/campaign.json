      "briefing": [
        [
          "King",
          "Commander. Good. There is ill news, and it walks our own roads."
        ],
        [
          "King",
          "Enemy spies move through the kingdom by night: the west wall road, the cave woods, the market lanes."
        ],
        [
          "King",
          "The watch counts twenty, scattered. They are learning our walls and our numbers."
        ],
        [
          "Commander",
          "What are your orders, Majesty?",
          "determined"
        ],
        [
          "King",
          "Hunt them. Kill ten and the rest will lose their nerve and run. Let them run."
        ],
        [
          "King",
          "Take your men. Go now, while the dark still hides them."
        ]
      ],
      "report": [
        [
          "King",
          "Ten dead, and the rest fled with nothing. That will keep them blind for a while."
        ],
        [
          "King",
          "Ten more men will march under you. You have earned them."
        ]
      ]
